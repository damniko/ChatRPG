<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ChatRPG.Application\ChatRPG.Application.csproj" />
      <ProjectReference Include="..\ChatRPG.Domain\ChatRPG.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="LangChain" Version="0.17.0" />
